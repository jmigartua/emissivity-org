<!DOCTYPE html><html lang="en"> <head><meta charset="UTF-8"><meta name="description" content="International Workshop on Advanced Topics"><meta name="viewport" content="width=device-width"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta name="generator" content="Astro v4.16.13"><title>IR-EMPOWER 2024 - Workshop on Infrared Emissivity Measurements</title><link rel="stylesheet" href="/_astro/index.C1IJB1t7.css"><script type="module">window.showSessionDetails=function(t){const e=JSON.parse(t.dataset.session||"{}");if(!e)return;const s=`
      <div class="space-y-6">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-3xl font-bold mb-2">${e.title}</h2>
            ${e.speaker?`
              <p class="text-xl text-gray-600">${e.speaker}</p>
              <p class="text-lg text-gray-500">${e.affiliation}</p>
            `:""}
          </div>
          <div class="text-lg font-medium text-primary">${e.time}</div>
        </div>
        
        ${e.abstract?`
          <div class="prose max-w-none">
            <h3 class="text-xl font-semibold mb-3">Abstract</h3>
            <p>${e.abstract}</p>
          </div>
        `:""}

        ${e.type!=="break"&&e.type!=="general"?`
          <div class="mt-6 flex items-center gap-2">
            <a 
              href="#" 
              class="inline-flex items-center px-4 py-2 rounded-lg bg-primary hover:bg-primary-dark text-white transition-colors"
              onclick="alert('Presentation will be available after the workshop'); return false;"
            >
              <span>View Presentation</span>
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        `:""}
      </div>
    `;window.openModalsession(s)};document.querySelectorAll(".speaker-card").forEach(t=>{t.addEventListener("click",()=>{const e=t.getAttribute("data-speaker-id");e&&window.openSpeakerModal&&window.openSpeakerModal(e)})});
</script></head> <body class="bg-white">  <header class="fixed w-full bg-white/90 backdrop-blur-sm z-50 border-b border-gray-100"> <nav class="container mx-auto px-4 py-3 flex justify-between items-center"> <a href="/" class="flex items-center gap-2"> <img src="/logos/ir-empower.svg" alt="IR-EMPOWER 2024" class="h-8"> </a> <ul class="hidden md:flex space-x-8"> <li> <a href="/" class="text-gray-600 hover:text-primary transition-colors"> Home </a> </li><li> <a href="#program" class="text-gray-600 hover:text-primary transition-colors"> Program </a> </li><li> <a href="#speakers" class="text-gray-600 hover:text-primary transition-colors"> Speakers </a> </li><li> <a href="#schedule" class="text-gray-600 hover:text-primary transition-colors"> Schedule </a> </li><li> <a href="#about" class="text-gray-600 hover:text-primary transition-colors"> About </a> </li><li> <a href="#sponsors" class="text-gray-600 hover:text-primary transition-colors"> Sponsors </a> </li> </ul> </nav> </header> <section class="relative min-h-screen flex items-center pt-16"> <!-- Background pattern --> <div class="absolute inset-0 -z-10 opacity-5"> <div class="h-full w-full bg-[radial-gradient(#663399_1px,transparent_1px)] [background-size:16px_16px]"></div> </div> <div class="container mx-auto px-4"> <div class="max-w-4xl mx-auto text-center"> <div class="mb-8"> <img src="/logos/ir-empower.svg" alt="IR-EMPOWER 2024" class="w-full max-w-2xl mx-auto"> </div> <p class="text-xl text-gray mb-8">
Workshop on Infrared Emissivity Measurements
</p> <div class="flex flex-col sm:flex-row gap-4 justify-center"> <a href="#register" class="bg-primary hover:bg-primary-dark text-white px-8 py-3 rounded-lg transition-colors">
Register Now
</a> <a href="#program" class="border border-gray-300 hover:border-primary text-gray hover:text-primary px-8 py-3 rounded-lg transition-colors">
View Program
</a> </div> <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8"> <div class="p-6 bg-white/50 backdrop-blur-sm rounded-xl border border-gray-100 shadow-sm"> <h3 class="font-semibold text-lg mb-2">When</h3> <p class="text-gray">September 5-6, 2024</p> </div> <div class="p-6 bg-white/50 backdrop-blur-sm rounded-xl border border-gray-100 shadow-sm"> <h3 class="font-semibold text-lg mb-2">Where</h3> <p class="text-gray">Bizkaia Aretoa, Bilbao</p> </div> <div class="p-6 bg-white/50 backdrop-blur-sm rounded-xl border border-gray-100 shadow-sm"> <h3 class="font-semibold text-lg mb-2">Organized by</h3> <p class="text-gray">UPV/EHU</p> </div> </div> </div> </div> </section> <section id="about" class="py-20"> <div class="container mx-auto px-4"> <h2 class="text-4xl font-bold text-center mb-12 text-gray-dark">About the Workshop</h2> <div class="max-w-4xl mx-auto space-y-8"> <div class="bg-white rounded-lg shadow-lg p-8"> <h3 class="text-2xl font-bold mb-6 text-primary">Organizing Committee</h3> <p class="mb-4 text-gray">Thermophysical Properties of Materials Research Group, University of the Basque Country (UPV/EHU)</p> <div class="grid md:grid-cols-2 gap-4"> <div class="p-3 bg-coral/10 rounded-lg border border-coral/20"> <p class="font-medium text-gray-dark">Iñigo González de Arrieta</p> </div><div class="p-3 bg-coral/10 rounded-lg border border-coral/20"> <p class="font-medium text-gray-dark">Telmo Echániz</p> </div><div class="p-3 bg-coral/10 rounded-lg border border-coral/20"> <p class="font-medium text-gray-dark">Gabriel A. López</p> </div><div class="p-3 bg-coral/10 rounded-lg border border-coral/20"> <p class="font-medium text-gray-dark">Raquel Fuente</p> </div><div class="p-3 bg-coral/10 rounded-lg border border-coral/20"> <p class="font-medium text-gray-dark">Josu M. Igartua</p> </div><div class="p-3 bg-coral/10 rounded-lg border border-coral/20"> <p class="font-medium text-gray-dark">Irene Urcelay-Olabarria</p> </div> </div> </div> <div class="bg-white rounded-lg shadow-lg p-8"> <h3 class="text-2xl font-bold mb-6 text-primary">International Advisory Board</h3> <div class="grid md:grid-cols-2 gap-4"> <div class="p-3 bg-accent/10 rounded-lg border border-accent/20"> <p class="font-medium text-gray-dark">Jochen Manara</p> <p class="text-gray text-sm">CAE, Würzburg</p> </div><div class="p-3 bg-accent/10 rounded-lg border border-accent/20"> <p class="font-medium text-gray-dark">Christian Monte</p> <p class="text-gray text-sm">PTB, Berlin</p> </div><div class="p-3 bg-accent/10 rounded-lg border border-accent/20"> <p class="font-medium text-gray-dark">Olivier Rozenbaum</p> <p class="text-gray text-sm">CEMHTI, Orléans</p> </div><div class="p-3 bg-accent/10 rounded-lg border border-accent/20"> <p class="font-medium text-gray-dark">Konstantinos Boboridis</p> <p class="text-gray text-sm">JRC, Karlsruhe</p> </div><div class="p-3 bg-accent/10 rounded-lg border border-accent/20"> <p class="font-medium text-gray-dark">Audrey Soum-Glaude</p> <p class="text-gray text-sm">PROMES, Odeillo</p> </div> </div> </div> </div> </div> </section> <section id="speakers" class="py-20"> <div class="container mx-auto px-4"> <h2 class="text-4xl font-bold text-center mb-12">Featured Speakers</h2> <!-- Plenary Speakers --> <div class="mb-16"> <h3 class="text-2xl font-bold mb-8">Plenary Speakers</h3> <div class="grid md:grid-cols-2 gap-6"> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="albert-adibekyan"> <div class="mb-4"> <img src="/speakers/albert-adibekyan.jpg" alt="Albert Adibekyan" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Albert Adibekyan</h4> <p class="text-gray mb-4">PTB, Berlin</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="jochen-manara"> <div class="mb-4"> <img src="/speakers/jochen-manara.jpg" alt="Jochen Manara" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Jochen Manara</h4> <p class="text-gray mb-4">CAE, Würzburg</p> <p class="text-sm text-primary">Click for details</p> </div>  </div> </div> <!-- Young Speakers --> <div class="mb-16"> <h3 class="text-2xl font-bold mb-8">Young Speakers</h3> <div class="grid md:grid-cols-3 gap-6"> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="david-urban"> <div class="mb-4"> <img src="/speakers/david-urban.jpg" alt="David Urban" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">David Urban</h4> <p class="text-gray mb-4">PTB, Berlin</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="hongyan-mei"> <div class="mb-4"> <img src="/speakers/hongyan-mei.jpg" alt="Hongyan Mei" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Hongyan Mei</h4> <p class="text-gray mb-4">University of Wisconsin, Madison</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="leo-gaillard"> <div class="mb-4"> <img src="/speakers/leo-gaillard.jpg" alt="Léo Gaillard" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Léo Gaillard</h4> <p class="text-gray mb-4">LTeN-CNRS, Nantes</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="mireia-sainz-menchon"> <div class="mb-4"> <img src="/speakers/mireia-sainz-menchon.jpg" alt="Mireia Sainz-Menchón" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Mireia Sainz-Menchón</h4> <p class="text-gray mb-4">UPV/EHU, Leioa</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="jon-gabirondo-lopez"> <div class="mb-4"> <img src="/speakers/jon-gabirondo-lopez.jpg" alt="Jon Gabirondo-López" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Jon Gabirondo-López</h4> <p class="text-gray mb-4">UPV/EHU, Leioa</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="matthias-tyslik"> <div class="mb-4"> <img src="/speakers/matthias-tyslik.jpg" alt="Matthias Tyslik" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Matthias Tyslik</h4> <p class="text-gray mb-4">Ruhr University, Bochum</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="lukas-portner"> <div class="mb-4"> <img src="/speakers/lukas-portner.jpg" alt="Lukas Pörtner" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Lukas Pörtner</h4> <p class="text-gray mb-4">Ruhr University, Bochum</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="hunter-schonfeld"> <div class="mb-4"> <img src="/speakers/hunter-schonfeld.jpg" alt="Hunter B. Schonfeld" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Hunter B. Schonfeld</h4> <p class="text-gray mb-4">University of Virginia, Charlottesville</p> <p class="text-sm text-primary">Click for details</p> </div>  </div> </div> <!-- Regular Speakers --> <div> <h3 class="text-2xl font-bold mb-8">Regular Invited Speakers</h3> <div class="grid md:grid-cols-3 gap-6"> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="elisa-sani"> <div class="mb-4"> <img src="/speakers/elisa-sani.jpg" alt="Elisa Sani" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Elisa Sani</h4> <p class="text-gray mb-4">INO-CNR, Florence</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="zdenek-vesely"> <div class="mb-4"> <img src="/speakers/zdenek-vesely.jpg" alt="Zdeněk Veselý" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Zdeněk Veselý</h4> <p class="text-gray mb-4">University of West Bohemia, Pilsen</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="julian-gieseler"> <div class="mb-4"> <img src="/speakers/julian-gieseler.jpg" alt="Julian Gieseler" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Julian Gieseler</h4> <p class="text-gray mb-4">LASP, Boulder &amp; PTB, Berlin</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="leire-del-campo"> <div class="mb-4"> <img src="/speakers/leire-del-campo.jpg" alt="Leire del Campo" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Leire del Campo</h4> <p class="text-gray mb-4">CEMHTI-CNRS, Orleans</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="domingos-de-sousa-meneses"> <div class="mb-4"> <img src="/speakers/domingos-de-sousa-meneses.jpg" alt="Domingos De Sousa Meneses" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Domingos De Sousa Meneses</h4> <p class="text-gray mb-4">CEMHTI-CNRS, Orleans</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="nenad-milosevic"> <div class="mb-4"> <img src="/speakers/nenad-milosevic.jpg" alt="Nenad Milošević" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Nenad Milošević</h4> <p class="text-gray mb-4">Institute VINČA, Belgrade</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="tomas-kralik"> <div class="mb-4"> <img src="/speakers/tomas-kralik.jpg" alt="Tomáš Králík" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Tomáš Králík</h4> <p class="text-gray mb-4">Czech Academy of Sciences, Brno</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="konstantinos-boboridis"> <div class="mb-4"> <img src="/speakers/konstantinos-boboridis.jpg" alt="Konstantinos Boboridis" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Konstantinos Boboridis</h4> <p class="text-gray mb-4">Joint Research Center, Karlsruhe</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="christophe-escape"> <div class="mb-4"> <img src="/speakers/christophe-escape.jpg" alt="Christophe Escape" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Christophe Escape</h4> <p class="text-gray mb-4">PROMES-CNRS, Odeillo</p> <p class="text-sm text-primary">Click for details</p> </div> <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow cursor-pointer speaker-card hover:border-primary border-2 border-transparent" data-speaker-id="yannick-le-maoult"> <div class="mb-4"> <img src="/speakers/yannick-le-maoult.jpg" alt="Yannick Le Maoult" class="w-full h-48 object-cover rounded-lg"> </div> <h4 class="text-xl font-bold mb-2 text-gray-dark">Yannick Le Maoult</h4> <p class="text-gray mb-4">IMT Mines, Albi</p> <p class="text-sm text-primary">Click for details</p> </div>  </div> </div> </div> <!-- Modal for speaker details --> <div id="speaker-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden" role="dialog" aria-modal="true"> <div class="min-h-screen px-4 text-center"> <div class="fixed inset-0" aria-hidden="true"></div> <div class="inline-block min-h-screen align-middle">&#8203;</div> <div class="inline-block w-full max-w-4xl p-6 my-8 text-left align-middle transition-all transform bg-white shadow-xl rounded-lg relative z-20 overflow-y-auto max-h-[90vh]"> <div class="absolute top-0 right-0 pt-4 pr-4"> <button type="button" class="close-modal text-gray-400 hover:text-gray-500"> <span class="sr-only">Close</span> <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path> </svg> </button> </div> <div class="modal-content space-y-6"> <!-- Content will be dynamically inserted here --> </div> </div> </div> </div> <script>(function(){const speakers = [{"id":"albert-adibekyan","name":"Albert Adibekyan","affiliation":"PTB, Berlin","title":"Emissivity measurements below 1000°C at PTB - an overview","abstract":"The accurate knowledge of the emissivity of a material is crucial for a variety of technological applications whenever heat transfer by radiation becomes significant.","fullAbstract":"The accurate knowledge of the emissivity of a material is crucial for a variety of technological applications whenever heat transfer by radiation becomes significant. Examples of applications which require very low uncertainties of emissivity knowledge are absorbers for solar thermal electricity generation, coatings of onboard reference blackbodies for missions in space and highly developing passive radiative cooling technologies.\n\nThe Physikalisch-Technische Bundesanstalt (PTB) operates two unique facilities for angular resolved measurements of the directional spectral, directional total and hemispherical total emissivities under air and in vacuum covering the spectral range from 1.4 μm to 200 μm and the temperature range from -40°C to 1000°C. The Emissivity Measurements in Air Facility (EMAF) and the Reduced Background Calibration Facility (RBCF 2) have been operated at PTB for several years and have successfully contributed to several research projects.\n\nUsing the direct radiometric method based on the measurement of the spectral radiance of a sample inside a temperature stabilized spherical enclosure with respect to the spectral radiance of two reference blackbodies at different temperatures, the measurements are traceable to the International Temperature Scale ITS-90.","photo":"/speakers/albert-adibekyan.jpg","category":"plenary"},{"id":"jochen-manara","name":"Jochen Manara","affiliation":"CAE, Würzburg","title":"Applied metrological facilities for determining the emissivity in a wide temperature range","abstract":"Thermal radiation is one of the fundamental mechanisms besides conduction and convection, which contributes to heat transfer through porous materials as well as to heat exchange between surfaces.","fullAbstract":"Thermal radiation is one of the fundamental mechanisms besides conduction and convection, which contributes to heat transfer through porous materials as well as to heat exchange between surfaces. In general, radiative transport provides a significant contribution even at lower temperatures, which increases significantly with increasing temperature. The reliable and traceable measurement of the emissivity is essential for accurately quantifying the energy, which is emitted by a surface as well as for precisely performing non-contact temperature measurements.\n\nHowever, the emissivity of a surface strongly depends not only on the material and its composition but also on the morphology of the material, as well as on the roughness and oxidation state of the surface. The reliability or comparability of literature data is often limited because not all relevant material and surface properties are given with the listed values.\n\nIn particular, an experimental setup with a FTIR-spectrometer and a so-called emissivity measurement apparatus (EMMA) for determining the angular-dependent directional spectral emissivity of opaque specimens as a function of temperature and wavelength by a direct radiometric method will be discussed.","photo":"/speakers/jochen-manara.jpg","category":"plenary"},{"id":"david-urban","name":"David Urban","affiliation":"PTB, Berlin","title":"Measuring the Spectral Emissivity above 1000 K","abstract":"PTB uses a dynamic method to measure the spectral emissivity (ADeM) in the temperature range from 1000 K up to 2700 K based on a modified Laser-Flash apparatus.","fullAbstract":"PTB uses a dynamic method to measure the spectral emissivity (ADeM) in the temperature range from 1000 K up to 2700 K based on a modified Laser-Flash apparatus. The sample is inductively heated to the desired temperature, under argon atmosphere in a water-cooled sample chamber, and is than hit by a short, high energy laser pulse.\n\nThe emissivity at the laser wavelength of λ₀=1064 nm can be determined by measuring the absolute laser energy incident at the sample front side E and the absolute, adiabatic temperature rise of the backside of the sample ΔT.\n\nA well characterized beam splitter is used to measure the energy of the laser pulse in situ with a calibrated thermopile. The temperature rise on the back side of the sample is measured with an absolute calibrated, fast radiation thermometer operating at the laser wavelength.\n\nTypical standard uncertainties for the spectral emissivity range from 2% to 4% at 1064 nm and 5% to 10% across the spectral range from 500 nm to 1100 nm.","photo":"/speakers/david-urban.jpg","category":"young"},{"id":"hongyan-mei","name":"Hongyan Mei","affiliation":"University of Wisconsin, Madison","title":"Direct Measurement of Infrared Emission Using Fourier-Transform Spectroscopy","abstract":"Engineering of thermal radiation for solar-energy harvesting, thermal light sources, passive radiative cooling, and infrared camouflage requires precision measurement of infrared emissivity.","fullAbstract":"Engineering of thermal radiation for solar-energy harvesting, thermal light sources, passive radiative cooling, and infrared camouflage requires precision measurement of infrared emissivity. For reciprocal emitters in equilibrium where Kirchhoff's law applies, emission can be indirectly obtained by measuring absorption. However, there are scenarios where direct emission measurement must be performed, for example nonreciprocal emitters where Kirchhoff's law is violated and emitters not in equilibrium.\n\nDirect thermal-emission measurement can be challenging due to various sources of background radiation, even from the instrument itself. Our group has been working on direct thermal-emission measurement using a commercial Fourier-transform spectroscopy system integrated with an infrared microscope and a temperature control system, and we developed comprehensive procedures for thermal-emission measurements, including characterization of emitters not in equilibrium or with temperature-dependent emissivity.","photo":"/speakers/hongyan-mei.jpg","category":"young"},{"id":"leo-gaillard","name":"Léo Gaillard","affiliation":"LTeN-CNRS, Nantes","title":"High-Temperature Emissivity of Cerium Oxide Ceramics","abstract":"Knowledge of the thermal radiative properties of cerium oxide up to 1500°C under low pO₂ (10⁻⁵ atm) is crucial to the design of efficient high-temperature reactors used to produce hydrogen.","fullAbstract":"Knowledge of the thermal radiative properties of cerium oxide up to 1500°C under low pO₂ (10⁻⁵ atm) is crucial to the design of efficient high-temperature reactors used to produce hydrogen by following a two-step redox thermochemical cycle driven by solar energy. The lack of data leads to biases, particularly in the numerical design of new additively manufactured 3D architectures that appear promising for hydrogen production.\n\nTo date, radiative properties are rather obtained at room temperature and normal pressure for samples that can be either sintered ceramics or thin films. In the following, we develop a dual approach based on multi-scale analytical modelling and experimental measurement of the normal spectral emissivity taking into account the operating conditions under which cerium oxide-based reactors are used in solar thermochemistry.","photo":"/speakers/leo-gaillard.jpg","category":"young"},{"id":"mireia-sainz-menchon","name":"Mireia Sainz-Menchón","affiliation":"UPV/EHU, Leioa","title":"Developing a Modular and High-Performance Infrared Emissometer","abstract":"The HAIRL emissometer is a mid-infrared emissometer that was designed and build on the University of the Basque Country (UPV/EHU).","fullAbstract":"The HAIRL emissometer (High Accuracy Infrared Radiometer, Leioa) is a mid-infrared emissometer that was designed and build on the University of the Basque Country (UPV/EHU). The instrument consists of a Fourier Transform Infrared Spectrophotometer (FT-IR); a water-cooled vacuum sample chamber; a reference blackbody and an optical system that allows selecting the source of radiation that enters the FT-IR.\n\nThe FT-IR measures spectral emissivity in the range between 0.83 and 25 μm. Samples are mounted on an electrical heater that can increase the surface temperature of the samples up to 1273 K. That sample holder is attached to an axis parallel to the measured surface inside the aforementioned chamber, so that directional and spectral emissivity experiments can be performed under a controlled atmosphere.\n\nDuring years of service, it has undergone instrumental and methodological updates, such as different uncertainty budgets and the implementation of a Monte Carlo method to integrate spectral and directional data. From 2021, the instrument has been in constant development.","photo":"/speakers/mireia-sainz-menchon.jpg","category":"young"},{"id":"jon-gabirondo-lopez","name":"Jon Gabirondo-López","affiliation":"UPV/EHU, Leioa","title":"Towards an Open Community of Radiative Properties","abstract":"The community of research groups specializing in the characterization of radiative properties faces several challenges compared to groups that work with other thermophysical properties.","fullAbstract":"The community of research groups specializing in the characterization of radiative properties faces several challenges compared to groups that work with other thermophysical properties. There is no commercial instrument to perform this kind of experiment at elevated temperatures, so all groups have designed and built their own equipment. This has led to a highly diverse ecosystem where each setup is based on different hardware, uses its own methodology, and can only measure a restricted set of materials.\n\nTo tackle these challenges, our community should schedule regular meetings and conferences to address the technical and methodological issues encountered by the laboratories. This will provide a wider perspective of the field and a deeper understanding of the instruments. Enhanced communication is expected to lead to the standardization of measuring methods, improving the comparison capabilities of the teams.\n\nWe are introducing an open framework for reporting experimental results in a metrologically correct manner. This framework adheres to the FAIR guidelines, Open Data standard, as well as the rules and suggestions defined by the VIM and the GUM.","photo":"/speakers/jon-gabirondo-lopez.jpg","category":"young"},{"id":"matthias-tyslik","name":"Matthias Tyslik","affiliation":"Ruhr University, Bochum","title":"Radiative Heat Transfer Measurements in Packed Beds","abstract":"Radiative heat transfer plays a major role in many technical applications like production in hearth furnaces, calcining of limestone or thermal energy storage.","fullAbstract":"Radiative heat transfer plays a major role in many technical applications like production in hearth furnaces, calcining of limestone or thermal energy storage. Although these and many other applications rely on heat transfer in dense particle assemblies, classical modelling of such situations is still connected to some questions and limitations.\n\nFor a detailed understanding of the radiation phenomena, and to build a fundamental dataset for subsequent model development, an experimental setup is used which allows to obtain detailed information about the heat and radiation propagation in a simplified packed bed. Two typical optical measurement techniques are combined to get a maximum of information on the radiative field in this setup. An IR-camera and a modified FT-IR are used to investigate the dependence of the surface properties of two different materials on radiative transfer.","photo":"/speakers/matthias-tyslik.jpg","category":"young"},{"id":"lukas-portner","name":"Lukas Pörtner","affiliation":"Ruhr University, Bochum","title":"Time-Resolved Emissivity of Biomass Fuel Particles","abstract":"Radiation in solid fuel fired combustion chambers is one of the main heat transfer mechanisms in industrial furnaces.","fullAbstract":"Radiation in solid fuel fired combustion chambers is one of the main heat transfer mechanisms in industrial furnaces. The radiation emitted by single fuel particles is directly connected to the combustion processes. It determines the heat loss of reacting fuel particles, which on the one hand provides heat for the thermal process, but also balances the particle temperature with direct influence on reaction rates.\n\nTo identify these emissivity changes, an experimental setup is presented, enabling the time resolved determination of the single fuel particle emissivity for particles on the sub-millimeter size range. Therefore, the setup applies various measurement methods from different optical measurement fields. As single particles are burned under the influence of a laser system, these methods implement the determination of the time resolved average particle temperature, diameter and total emitted radiation in the infrared spectrum.","photo":"/speakers/lukas-portner.jpg","category":"young"},{"id":"hunter-schonfeld","name":"Hunter B. Schonfeld","affiliation":"University of Virginia, Charlottesville","title":"Direct and indirect measurement of spectral emissivity and emittance from room temperature to 4000°C","abstract":"New materials are being developed with intentions for use in ultra-high temperature, ultra-high heat flux applications.","fullAbstract":"New materials are being developed with intentions for use in ultra-high temperature, ultra-high heat flux applications. These materials' radiative properties must be known at relevant temperatures for their application both for modeling their thermal performance, as well as to understand their radiative properties from a fundamental level to inform the design of the next generation of material systems as well.\n\nWe have developed a new experimental setup based on localized laser heating and hyperspectral radiation pyrometry to directly determine the normal spectral emissivity and emittance of materials from near room temperatures to temperatures exceeding 4000°C. To conduct these experiments we utilize a high power continuous wave laser which locally heats our material to our desired temperature.\n\nWe then use multiple hyperspectral pyrometers calibrated with a graphite tube blackbody up to 3000°C, to measure radiance at discrete wavelengths with narrow bandwidth and use a previously developed analysis procedure to determine the true temperature with high accuracy without knowledge of the materials spectral emissivity.","photo":"/speakers/hunter-schonfeld.jpg","category":"young"},{"id":"elisa-sani","name":"Elisa Sani","affiliation":"INO-CNR, Florence","title":"Spectral emittance of ceramics for high temperature solar receivers","abstract":"We describe our homemade setup for spectral thermal emissivity measurements and we summarize the experimental temperature-dependent spectral emittance of silicon carbide (SiC), tantalum diboride (TaB₂) and zirconium diboride (ZrB₂).","fullAbstract":"We describe our homemade setup for spectral thermal emissivity measurements and we summarize the experimental temperature-dependent spectral emittance of silicon carbide (SiC), tantalum diboride (TaB₂) and zirconium diboride (ZrB₂) to evaluate their potential for solar tower receivers applications.\n\nSiC is historically the most studied material for solar tower receivers, mainly in the volumetric absorber configuration, while TaB₂ and ZrB₂ are advanced refractory ceramics with outstanding solid state stability, excellent thermomechanical properties, and extremely high melting points, above 3000°C.\n\nThe spectral normal emittance of samples is measured from 1 to 21 μm at temperatures up to 850°C, by means of an experimental setup composed by a high vacuum electric furnace interfaced, through proper optical systems, with two spectrometers covering different spectral ranges.","photo":"/speakers/elisa-sani.jpg","category":"regular"},{"id":"zdenek-vesely","name":"Zdeněk Veselý","affiliation":"University of West Bohemia, Pilsen","title":"Photo-thermal properties measurement of coatings at low and high temperatures","abstract":"The contribution refers to the developed methods for the analysis of photo-thermal properties of coatings.","fullAbstract":"The contribution refers to the developed methods for the analysis of photo-thermal properties of coatings. The knowledge of these properties is important for coatings applied to energy industry, mechanical engineering and civil engineering, everywhere the heat transfer by infrared radiation take place.\n\nThere is need to analyse reflectivity, transmissivity, emissivity and absorptivity particularly in the infrared wavelengths at room and high temperatures. The temperature, wavelength and directional distributions of these properties are important.\n\nPresentation of the developed methods includes standard measurement methods of spectral and directional dependent properties at room temperature. These analyses are extended by the method for emissivity measurement of semitransparent coatings deposited on the substrates.","photo":"/speakers/zdenek-vesely.jpg","category":"regular"},{"id":"julian-gieseler","name":"Julian Gieseler","affiliation":"LASP, Boulder & PTB, Berlin","title":"Measuring the apparent emissivity of semitransparent samples at PTB","abstract":"The increasing interest in industrial and scientific applications of semitransparent materials demands the precise and comprehensive measurement of their infrared optical properties.","fullAbstract":"The increasing interest in industrial and scientific applications of semitransparent materials demands the precise and comprehensive measurement of their infrared optical properties. For instance, the non-destructive testing of fiber-reinforced polymers (FRP) by passive or active thermography requires precise knowledge of the emittance of the material to quantitatively identify defects.\n\nInfrared optical properties of semi-transparent materials at temperatures between 20°C and 90°C and from 5 μm to 25 μm are difficult to measure because the detected optical signal is a superposition of reflected, transmitted, and emitted radiation. Furthermore, the apparent emittance, reflectance, and transmittance depend on the sample thickness.\n\nTherefore, the absorption coefficient and refractive index must be identified to enable repeatable comparison of different samples. To solve these problems, measurement scheme to directly measure apparent spectral emissivity of semitransparent samples at wavelengths from 5 μm to 25 μm and at temperatures from 20°C to 60°C will be presented.","photo":"/speakers/julian-gieseler.jpg","category":"regular"},{"id":"leire-del-campo","name":"Leire del Campo","affiliation":"CEMHTI-CNRS, Orleans","title":"Thermo-Radiative Properties by Infrared Spectroscopy from Room to High Temperatures","abstract":"The CEMHTI laboratory has several experimental facilities for assessing the thermo-radiative properties of materials over a wide spectral range and temperature range.","fullAbstract":"The CEMHTI laboratory has several experimental facilities for assessing the thermo-radiative properties (reflectance, transmittance and emittance) of materials over a wide spectral range (20-20.000 cm⁻¹) and temperature range (from 300 K up to 2500 K).\n\nAt room temperature, when the thermal emission of samples is too low to be directly detected, specular and/or diffuse (using an integrating sphere) reflectance and transmittance are measured; the use of Kirchhoff's' laws enables to indirectly determine the emissivity.\n\nConversely, as the temperature rises, the own thermal emission of the sample yields reflectance and transmittance measurement challenging, and thus, emittance is measured using the direct radiometric method, and the sample luminance in compared to that of a blackbody furnace.","photo":"/speakers/leire-del-campo.jpg","category":"regular"},{"id":"domingos-de-sousa-meneses","name":"Domingos De Sousa Meneses","affiliation":"CEMHTI-CNRS, Orleans","title":"Simultaneous measurement of temperature and normal spectral emittance under unconventional conditions","abstract":"Determining emissivity under unconventional conditions can often be a tricky task.","fullAbstract":"Determining emissivity under unconventional conditions can often be a tricky task. In this presentation, we will focus on two specific cases where traditional devices meet their limits.\n\nThe first method, Reflection-Enhanced Emission spectroscopy, deals with materials that do not have a good Christiansen point. The flux measurements acquired on the target illuminated or not by an external source make it possible to probe their reflectance and the other quantities sought under the same experimental conditions.\n\nThe second method, Rapid-Scan emission spectroscopy, as its name suggests, was developed to determine the two quantities in real time, during rapid transformations such as the solidification of material from its molten state at high temperature.","photo":"/speakers/domingos-de-sousa-meneses.jpg","category":"regular"},{"id":"nenad-milosevic","name":"Nenad Milošević","affiliation":"Institute VINČA, Belgrade","title":"Hemispherical total and normal spectral emissivity measurement of metals and alloys","abstract":"The direct pulse heating technique is applied for the measurement of thermophysical properties of electroconductive solids over a wide high temperature range.","fullAbstract":"The direct pulse heating technique is applied for the measurement of thermophysical properties of electroconductive solids over a wide high temperature range, i.e., from about 800°C to 2300°C for the hemispherical total and normal spectral emissivity.\n\nThe specimen under test undergoes a rapid resistive heating by short dc electrical current and a subsequent free cooling. During the experiment, the voltage drop over a specimen effective length, the current intensity through the specimen and the specimen absolute temperature are simultaneously recorded.\n\nThe former two signals alone provide information about the evolution of the energy spent for the specimen heating, from which the enthalpy of the system is found out. Having all the three signals, information about the specimen hemispherical total emissivity, specific heat and specific electrical resistivity in function of temperature is extracted.","photo":"/speakers/nenad-milosevic.jpg","category":"regular"},{"id":"tomas-kralik","name":"Tomáš Králík","affiliation":"Czech Academy of Sciences, Brno","title":"Method for measurement of emissivity and absorptivity at cryogenic temperatures","abstract":"The radiative heat transfer between two surfaces is determined mainly by their temperatures and their relative ability to emit or absorb thermal radiation.","fullAbstract":"The radiative heat transfer between two surfaces is determined mainly by their temperatures and their relative ability to emit or absorb thermal radiation, i.e. their emissivity or absorptivity. At low temperatures, both quantities are difficult to measure due to the low heat fluxes, especially in the case of highly reflective materials.\n\nWe present here a cryogenic method for measurement of total hemispherical emissivity or absorptivity. It is based on a unique apparatus developed by our team. The instrument detects the radiative heat flow between two plane parallel surfaces placed in evacuated measuring chamber; the tested sample and a reference disk with highly absorptive surface.\n\nThe main benefits of the method reside in the ability to measure either emissivity or absorptivity with the same instrument, wide temperature range from 10 K to 320 K and the ability to test various samples with extremely low as well as very high emissivity/absorptivity.","photo":"/speakers/tomas-kralik.jpg","category":"regular"},{"id":"konstantinos-boboridis","name":"Konstantinos Boboridis","affiliation":"Joint Research Center, Karlsruhe","title":"Investigating the highest melting temperature materials and the need for reliable emittance data","abstract":"At JRC Karlsruhe we employ a laser-based technique for the study of high-temperature phase diagrams, in particular melting and solidification.","fullAbstract":"At JRC Karlsruhe we employ a laser-based technique for the study of high-temperature phase diagrams, in particular melting and solidification. Materials of interest include conventional and advanced nuclear fuels and claddings, ultra-high-temperature ceramics, and targets for the production of medical radioisotopes for cancer theragnostic applications.\n\nUsing high-power lasers, temperatures exceeding 4000 K can be reached in short times. For work with radioactive materials, a glovebox provides alpha-shielding and prevents contamination. Fast radiation thermometers and infrared cameras record the surface radiance temperature of the sample.\n\nThe near-normal spectral emittance is estimated based on radiance spectrometry in the visible and NIR. Detection of melting and solidification is supported by the use of a low-power laser that is reflected off the sample and is sensitive to changes of its apparent reflectance.","photo":"/speakers/konstantinos-boboridis.jpg","category":"regular"},{"id":"christophe-escape","name":"Christophe Escape","affiliation":"PROMES-CNRS, Odeillo","title":"Measurement of thermooptical properties at PROMES-CNRS","abstract":"At PROMES Odeillo's solar furnace, optical properties are key points.","fullAbstract":"At PROMES Odeillo's solar furnace, optical properties are key points. Indeed, here are developped materials and surfaces for high temperature applications, such as components for future concentrated solar thermal plants working at mid- to high temperatures, spectrally selective coatings and bulk materials for energy and space.\n\nThe Optical and Thermal Properties service at PROMES aims to measure spectral, normal and directional emissivity, absorptivity, reflectivity and transmittivity, at room temperature and at high temperature, for various samples issued from internal developments and external researches.\n\nTo achieve this goal the OTP laboratory is articulated around the architecture of solar thermal power plants, from concentrating reflective mirrors to solar absorbers and energy storage materials.","photo":"/speakers/christophe-escape.jpg","category":"regular"},{"id":"yannick-le-maoult","name":"Yannick Le Maoult","affiliation":"IMT Mines, Albi","title":"Advanced Techniques in Radiative Properties","abstract":"IMT Mines Albi and its ICA laboratory has designed a bench for measuring directional spectral emissivity in the infrared range.","fullAbstract":"IMT Mines Albi and its ICA laboratory, specialised in materials science and mechanical engineering and more specifically the MICS research group involved in the development and implementation of advanced measuring equipments, has designed a bench for measuring directional spectral emissivity (BMEIR) in the infrared range between ~1 and 11 μm and for high temperatures (up to 1000°C and more).\n\nThis bench strengthens the testing-computation link in hot-forming processes for metallic materials or for understanding the interaction between radiation and materials for infrared heating and/or laser processes.\n\nIt complements an FTIR spectrometer equipped with an emission measurement system, but with a maximum temperature limited to 400°C. This presentation will therefore review the current equipment, its possibilities, performances and prospects, and will present measurements carried out on different types of materials and situations.","photo":"/speakers/yannick-le-maoult.jpg","category":"regular"}];
const id = "speaker-modal";

  const modal = document.getElementById(id);
  const closeButton = modal?.querySelector('.close-modal');
  const modalContent = modal?.querySelector('.modal-content');

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  }

  closeButton?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  window.openSpeakerModal = function(speakerId) {
    const speaker = speakers.find(s => s.id === speakerId);
    if (!speaker || !modalContent || !modal) return;

    const content = `
      <div class="flex flex-col md:flex-row gap-8">
        ${speaker.photo ? `
          <div class="w-full md:w-1/3">
            <img src="${speaker.photo}" alt="${speaker.name}" class="w-full rounded-lg shadow-lg">
          </div>
        ` : ''}
        <div class="w-full ${speaker.photo ? 'md:w-2/3' : ''}">
          <h2 class="text-3xl font-bold mb-2">${speaker.name}</h2>
          <p class="text-xl text-gray-600 mb-4">${speaker.affiliation}</p>
          <h3 class="text-2xl font-semibold mb-4">${speaker.title}</h3>
          <div class="prose max-w-none">
            ${speaker.fullAbstract ? 
              speaker.fullAbstract.split('\n\n').map(p => `<p>${p}</p>`).join('') :
              `<p>${speaker.abstract}</p>`
            }
          </div>
          <div class="mt-6 flex items-center gap-2">
            <a 
              href="#" 
              class="inline-flex items-center px-4 py-2 rounded-lg bg-primary hover:bg-primary-dark text-white transition-colors"
              onclick="alert('Presentation will be available after the workshop'); return false;"
            >
              <span>View Presentation</span>
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    `;

    modalContent.innerHTML = content;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };
})();</script> </section> <section id="program" class="py-20 bg-gray-50"> <div class="container mx-auto px-4"> <h2 class="text-4xl font-bold text-center mb-12">Program Overview</h2> <div class="max-w-4xl mx-auto space-y-8"> <!-- Key Topics --> <div class="bg-white rounded-lg shadow-lg p-8"> <h3 class="text-2xl font-bold mb-4 text-primary">Key Topics</h3> <ul class="space-y-3"> <li class="flex items-start"> <span class="text-primary mr-2">•</span> <span>Techniques for emissivity measurement at various temperatures and conditions</span> </li><li class="flex items-start"> <span class="text-primary mr-2">•</span> <span>Development of specialized instruments like high-performance infrared emissometers</span> </li><li class="flex items-start"> <span class="text-primary mr-2">•</span> <span>Challenges in high-temperature radiative property characterization</span> </li><li class="flex items-start"> <span class="text-primary mr-2">•</span> <span>Applications in energy storage, solar thermal plants, aerospace, and cryogenics</span> </li> </ul> </div> <!-- Featured Abstracts --> <div class="bg-white rounded-lg shadow-lg p-8"> <h3 class="text-2xl font-bold mb-6 text-primary">Featured Abstracts</h3> <div class="space-y-8"> <div class="border-b border-gray-200 pb-6 last:border-0"> <h4 class="font-bold text-xl mb-2">Emissivity measurements below 1000 °C at PTB</h4> <p class="text-gray-600 mb-4">Albert Adibekyan (PTB, Berlin)</p> <p class="text-gray-700">This presentation highlighted PTB&#39;s advanced facilities for emissivity measurement, including the Emissivity Measurements in Air Facility (EMAF) and the Reduced Background Calibration Facility (RBCF 2). The methods are traceable to the ITS-90 temperature scale and allow for precise emissivity evaluation of various materials under air and vacuum conditions.</p> </div><div class="border-b border-gray-200 pb-6 last:border-0"> <h4 class="font-bold text-xl mb-2">Applied Metrological Facilities for Determining Emissivity in a Wide Temperature Range</h4> <p class="text-gray-600 mb-4">Jochen Manara (CAE, Würzburg)</p> <p class="text-gray-700">Discussed radiometric methods and equipment like the EMMA setup for angular-dependent emissivity measurements. Techniques covered include FTIR spectrometry, black-body boundary conditions for semi-transparent materials, and pulse heating methods for high-temperature applications.</p> </div> </div> </div> </div> </div> </section> <section id="schedule" class="py-20 bg-gray-50"> <div class="container mx-auto px-4"> <h2 class="text-4xl font-bold text-center mb-12">Program Schedule</h2> <div class="max-w-6xl mx-auto space-y-12"> <!-- Legend --> <div class="flex flex-wrap gap-4 justify-center"> <div class="flex items-center gap-2"> <div class="w-4 h-4 bg-coral/10 border border-coral"></div> <span>Plenary Talks</span> </div> <div class="flex items-center gap-2"> <div class="w-4 h-4 bg-accent/10 border border-accent"></div> <span>Young Speakers</span> </div> <div class="flex items-center gap-2"> <div class="w-4 h-4 bg-secondary/10 border border-secondary"></div> <span>Regular Talks</span> </div> </div> <div class="bg-white rounded-lg shadow-lg overflow-hidden"> <h3 class="text-2xl font-bold p-6 bg-primary text-white"> September 5, 2024 </h3> <div class="divide-y"> <div class="p-6 transition-colors cursor-pointer hover:bg-gray-50" data-session="{&#34;time&#34;:&#34;8:30 - 9:00&#34;,&#34;title&#34;:&#34;Registration&#34;,&#34;type&#34;:&#34;general&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">8:30 - 9:00</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Registration</h4>  </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer hover:bg-gray-50" data-session="{&#34;time&#34;:&#34;9:00 - 9:15&#34;,&#34;title&#34;:&#34;Opening Remarks&#34;,&#34;type&#34;:&#34;general&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">9:00 - 9:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Opening Remarks</h4>  </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer bg-coral/10 hover:bg-coral/20" data-session="{&#34;time&#34;:&#34;9:15 - 10:15&#34;,&#34;title&#34;:&#34;Emissivity measurements below 1000°C at PTB - an overview&#34;,&#34;type&#34;:&#34;plenary&#34;,&#34;speaker&#34;:&#34;Albert Adibekyan&#34;,&#34;affiliation&#34;:&#34;PTB, Berlin&#34;,&#34;abstract&#34;:&#34;The accurate knowledge of the emissivity of a material is crucial for a variety of technological applications whenever heat transfer by radiation becomes significant. Examples of applications which require very low uncertainties of emissivity knowledge are absorbers for solar thermal electricity generation, coatings of onboard reference blackbodies for missions in space and highly developing passive radiative cooling technologies.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">9:15 - 10:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Emissivity measurements below 1000°C at PTB - an overview</h4> <p class="text-gray"> Albert Adibekyan (PTB, Berlin)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors  bg-gray-50 hover:bg-gray-100" data-session="{&#34;time&#34;:&#34;10:15 - 10:45&#34;,&#34;title&#34;:&#34;Coffee Break&#34;,&#34;type&#34;:&#34;break&#34;}"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">10:15 - 10:45</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Coffee Break</h4>  </div>  </div> </div><div class="p-6 transition-colors cursor-pointer bg-coral/10 hover:bg-coral/20" data-session="{&#34;time&#34;:&#34;10:45 - 11:45&#34;,&#34;title&#34;:&#34;Applied metrological facilities for determining the emissivity in a wide temperature range&#34;,&#34;type&#34;:&#34;plenary&#34;,&#34;speaker&#34;:&#34;Jochen Manara&#34;,&#34;affiliation&#34;:&#34;CAE, Würzburg&#34;,&#34;abstract&#34;:&#34;Thermal radiation is one of the fundamental mechanisms besides conduction and convection, which contributes to heat transfer through porous materials as well as to heat exchange between surfaces. In general, radiative transport provides a significant contribution even at lower temperatures, which increases significantly with increasing temperature.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">10:45 - 11:45</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Applied metrological facilities for determining the emissivity in a wide temperature range</h4> <p class="text-gray"> Jochen Manara (CAE, Würzburg)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;11:45 - 12:15&#34;,&#34;title&#34;:&#34;Measuring the Spectral Emissivity above 1000 K&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;David Urban&#34;,&#34;affiliation&#34;:&#34;PTB, Berlin&#34;,&#34;abstract&#34;:&#34;PTB uses a dynamic method to measure the spectral emissivity (ADeM) in the temperature range from 1000 K up to 2700 K based on a modified Laser-Flash apparatus. The sample is inductively heated to the desired temperature, under argon atmosphere in a water-cooled sample chamber, and is than hit by a short, high energy laser pulse.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">11:45 - 12:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Measuring the Spectral Emissivity above 1000 K</h4> <p class="text-gray"> David Urban (PTB, Berlin)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors  bg-gray-50 hover:bg-gray-100" data-session="{&#34;time&#34;:&#34;12:15 - 13:45&#34;,&#34;title&#34;:&#34;Lunch Break&#34;,&#34;type&#34;:&#34;break&#34;}"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">12:15 - 13:45</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Lunch Break</h4>  </div>  </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;13:45 - 14:15&#34;,&#34;title&#34;:&#34;Direct Measurement of Infrared Emission Using Fourier-Transform Spectroscopy&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;Hongyan Mei&#34;,&#34;affiliation&#34;:&#34;University of Wisconsin, Madison&#34;,&#34;abstract&#34;:&#34;Engineering of thermal radiation for solar-energy harvesting, thermal light sources, passive radiative cooling, and infrared camouflage requires precision measurement of infrared emissivity. For reciprocal emitters in equilibrium where Kirchhoff's law applies, emission can be indirectly obtained by measuring absorption.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">13:45 - 14:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Direct Measurement of Infrared Emission Using Fourier-Transform Spectroscopy</h4> <p class="text-gray"> Hongyan Mei (University of Wisconsin, Madison)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;14:15 - 14:45&#34;,&#34;title&#34;:&#34;High-Temperature Emissivity of Cerium Oxide Ceramics&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;Léo Gaillard&#34;,&#34;affiliation&#34;:&#34;LTeN-CNRS, Nantes&#34;,&#34;abstract&#34;:&#34;Knowledge of the thermal radiative properties of cerium oxide up to 1500°C under low pO₂ (10⁻⁵ atm) is crucial to the design of efficient high-temperature reactors used to produce hydrogen by following a two-step redox thermochemical cycle driven by solar energy.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">14:15 - 14:45</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">High-Temperature Emissivity of Cerium Oxide Ceramics</h4> <p class="text-gray"> Léo Gaillard (LTeN-CNRS, Nantes)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors  bg-gray-50 hover:bg-gray-100" data-session="{&#34;time&#34;:&#34;14:45 - 15:15&#34;,&#34;title&#34;:&#34;Coffee Break&#34;,&#34;type&#34;:&#34;break&#34;}"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">14:45 - 15:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Coffee Break</h4>  </div>  </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;15:15 - 15:45&#34;,&#34;title&#34;:&#34;Developing a Modular and High-Performance Infrared Emissometer&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;Mireia Sainz-Menchón&#34;,&#34;affiliation&#34;:&#34;UPV/EHU, Leioa&#34;,&#34;abstract&#34;:&#34;The HAIRL emissometer is a mid-infrared emissometer that was designed and build on the University of the Basque Country (UPV/EHU). The instrument consists of a Fourier Transform Infrared Spectrophotometer (FT-IR); a water-cooled vacuum sample chamber; a reference blackbody and an optical system that allows selecting the source of radiation that enters the FT-IR.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">15:15 - 15:45</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Developing a Modular and High-Performance Infrared Emissometer</h4> <p class="text-gray"> Mireia Sainz-Menchón (UPV/EHU, Leioa)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;15:45 - 16:15&#34;,&#34;title&#34;:&#34;Towards an Open Community of Radiative Properties&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;Jon Gabirondo-López&#34;,&#34;affiliation&#34;:&#34;UPV/EHU, Leioa&#34;,&#34;abstract&#34;:&#34;The community of research groups specializing in the characterization of radiative properties faces several challenges compared to groups that work with other thermophysical properties. There is no commercial instrument to perform this kind of experiment at elevated temperatures, so all groups have designed and built their own equipment.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">15:45 - 16:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Towards an Open Community of Radiative Properties</h4> <p class="text-gray"> Jon Gabirondo-López (UPV/EHU, Leioa)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;16:15 - 16:45&#34;,&#34;title&#34;:&#34;Radiative Heat Transfer Measurements in Packed Beds&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;Matthias Tyslik&#34;,&#34;affiliation&#34;:&#34;Ruhr University, Bochum&#34;,&#34;abstract&#34;:&#34;Radiative heat transfer plays a major role in many technical applications like production in hearth furnaces, calcining of limestone or thermal energy storage. Although these and many other applications rely on heat transfer in dense particle assemblies, classical modelling of such situations is still connected to some questions and limitations.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">16:15 - 16:45</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Radiative Heat Transfer Measurements in Packed Beds</h4> <p class="text-gray"> Matthias Tyslik (Ruhr University, Bochum)
</p> </div> <div class="flex-shrink-0 text-primary">
View Details →
</div> </div> </div><div class="p-6 transition-colors cursor-pointer bg-accent/10 hover:bg-accent/20" data-session="{&#34;time&#34;:&#34;16:45 - 17:15&#34;,&#34;title&#34;:&#34;Time-Resolved Emissivity of Biomass Fuel Particles&#34;,&#34;type&#34;:&#34;young&#34;,&#34;speaker&#34;:&#34;Lukas Pörtner&#34;,&#34;affiliation&#34;:&#34;Ruhr University, Bochum&#34;,&#34;abstract&#34;:&#34;Radiation in solid fuel fired combustion chambers is one of the main heat transfer mechanisms in industrial furnaces. The radiation emitted by single fuel particles is directly connected to the combustion processes.&#34;}" onclick="showSessionDetails(this)"> <div class="flex items-start justify-between gap-4"> <div class="w-32 flex-shrink-0"> <p class="font-medium">16:45 - 17:15</p> </div> <div class="flex-grow"> <h4 class="font-semibold text-lg mb-1">Time-Resolved Emissivity of Biomass Fuel Particles</h4> <p class="text-gray"> Lukas Pörtner (Ruhr University, Bochum)
