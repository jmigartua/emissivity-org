</div> </div> </div> </div> </div> </div> </div> </section> <div id="session" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden" role="dialog" aria-modal="true"> <div class="min-h-screen px-4 text-center"> <div class="fixed inset-0 z-10" aria-hidden="true"></div> <div class="inline-block min-h-screen align-middle">&#8203;</div> <div class="inline-block w-full max-w-2xl p-6 my-8 text-left align-middle transition-all transform bg-white shadow-xl rounded-lg relative z-20"> <div class="absolute top-0 right-0 pt-4 pr-4"> <button type="button" class="close-modal text-gray-400 hover:text-gray-500"> <span class="sr-only">Close</span> <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path> </svg> </button> </div> <div class="modal-content"></div> </div> </div> </div> <script>(function(){const id = "session";

  // Get modal elements
  const modal = document.getElementById(id);
  const closeButton = modal?.querySelector('.close-modal');
  const modalContent = modal?.querySelector('.modal-content');

  // Close modal function
  function closeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Event listeners
  closeButton?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Expose function to open modal
  window[`openModal${id}`] = function(content) {
    if (modalContent && modal) {
      modalContent.innerHTML = content;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  };
})();</script>  <section id="sponsors" class="py-20 bg-white"> <div class="container mx-auto px-4"> <h2 class="text-4xl font-bold text-center mb-12">Sponsors & Partners</h2> <!-- Main Organizers --> <div class="mb-16"> <h3 class="text-2xl font-bold text-center mb-8">Organized by</h3> <div class="flex flex-wrap justify-center items-center gap-12"> <div class="w-full max-w-xs"> <img src="/logos/tppm.svg" alt="TPPM Research Group" class="w-full"> </div> <div class="w-full max-w-sm"> <img src="/logos/upv-ehu.svg" alt="UPV/EHU" class="w-full"> </div> </div> </div> <!-- Institutional Support --> <div class="mb-16"> <h3 class="text-2xl font-bold text-center mb-8">Institutional Support</h3> <div class="flex justify-center"> <div class="w-full max-w-lg"> <img src="/logos/gobierno-vasco.svg" alt="Gobierno Vasco" class="w-full"> </div> </div> </div> <!-- Sponsors --> <div> <h3 class="text-2xl font-bold text-center mb-8">Sponsors</h3> <div class="flex flex-wrap justify-center items-center gap-12"> <div class="w-full max-w-xs"> <img src="/logos/bruker.svg" alt="Bruker" class="w-full"> </div> <div class="w-full max-w-xs"> <img src="/logos/coblentz.svg" alt="Coblentz Society" class="w-full"> </div> </div> </div> </div> </section>  </body></html> 