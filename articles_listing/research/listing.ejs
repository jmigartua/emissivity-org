<div class="research project-list">
<ul class="list">
<% for (const item of items) { %>
<li class="project" <%= metadataAttrs(item) %>>
<div class="project-title">
<a href="#" data-href="<%- encodeURI(item.path) %>" class="listing-name"><%- item.title %></a>
</div>
<div class="project-content listing-pub-info">
<p>
<%= item["pub-info"].reference %>
</p>
</div>
<% /* --- START: Citation Info Display (v2 - Using CSS) --- */ %>
<% if (item.citations && item.citations.count != null) { %>
<div class="project-citations listing-citations">
<span class="citation-count" title="Google Scholar Citations (retrieved: <%= item.citations.retrieved %>)">
<i class="ai ai-google-scholar-square" aria-hidden="true"></i>
<%= item.citations.count %> Citations
</span>
</div>
<% } %>
<% /* --- END: Citation Info Display --- */ %>
<% if (item.categories) { %>
<div class="project-categories">
<% for (const cat of item.categories) { %>
<div class="project-category">
<a href="#" data-href="#category=<%= encodeURIComponent(cat) %>"><%= cat %></a>
</div>
<% } %>
</div>
<% } %>
<% /* Loop through the haiku lines and prepend a / to all but the first */ %>
<% if (item.haiku) { %>
<div class="haiku">
<% for (var i = 0; i <= item.haiku.length - 1; i++) { %>
<% if (i > 0) { %> / <% } %>
<%= item.haiku[i] %>
<% } %>
</div>
<% } %>
<div class="project-details-listing">
<ul class="project-links">
<li class="project-link details">
<a href="#" data-href="<%- encodeURI(item.path) %>" class="listing-name">
<i class="fa-solid fa-circle-info"></i>
Full details »
</a>
</li>
<% if (item["pub-info"].links) { %>
<% for (const link of item["pub-info"].links) { %>
<li class="project-link">
<% if (link.local) { %>
<a href="#" data-href="<%- encodeURI(item.path.substring(0, item.path.lastIndexOf('/')) + '/' + link.url) %>">
<% } else { %>
<a href="#" data-href="<%- encodeURI(link.url) %>">
<% } %>
<i class="<%- link.icon %>"></i>
<%= link.name %>
</a>
</li>
<% } %>
<% } %>
</ul>
</div>
</li>
<% } %>
</ul>
</div>
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".project-list a[data-href]").forEach(function (link) {
    var href = link.getAttribute("data-href");
    if (href) {
      link.setAttribute("href", href);
    }
  });
});
</script>
